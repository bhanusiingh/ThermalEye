# syntax=docker/dockerfile:1
# ===========================================================================
# ThermalEye — Backend & Worker Production Dockerfile
# ===========================================================================

FROM python:3.12-slim

# Invariants & Performance settings
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system geospatial libraries & compilation tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url https://download.pytorch.org/whl/cpu torch torchvision && \
    grep -vE '^(torch|torchvision)' requirements.txt > /tmp/req_no_torch.txt && \
    pip install -r /tmp/req_no_torch.txt

# Create static imagery and data directories
RUN mkdir -p /app/static/imagery /app/data

# Copy application scripts
COPY main.py run_pipeline.py ingest_firms.py cluster_events.py enrich_osm_and_score.py fetch_imagery.py classify_landcover.py ./

# Copy bundled geospatial reference data and ML package
COPY data/ ./data/
COPY ml/ ./ml/

EXPOSE 8000

# Default command (overridden per service in docker-compose.yml)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

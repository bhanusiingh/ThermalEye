# NASA FIRMS API Map Key
# Obtain a free key at: https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub
# Create OAuth client at: https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional: override default CDSE API endpoints
# CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# CDSE_CATALOG_URL=https://sh.dataspace.copernicus.eu/catalog/v1/search
# CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1

# Optional: override Overpass API endpoint
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter

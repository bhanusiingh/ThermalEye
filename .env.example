# ===========================================================================
# ThermalEye — Environment Variables Template
# Copy this file to .env and provide your valid credentials:
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. NASA FIRMS API (Fire Information for Resource Management System)
# Request your free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
# ---------------------------------------------------------------------------
FIRMS_MAP_KEY=your_nasa_firms_map_key_here
FIRMS_AREA=68.1,6.7,97.4,37.5

# ---------------------------------------------------------------------------
# 2. Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub
# Register at: https://dataspace.copernicus.eu/
# Generate OAuth2 credentials in User Profile -> Sentinel Hub -> OAuth clients
# ---------------------------------------------------------------------------
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CATALOG_URL=https://sh.dataspace.copernicus.eu/catalog/v1/search
CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# ---------------------------------------------------------------------------
# 3. OpenStreetMap (OSM) / Overpass & Nominatim
# Public Overpass mirrors do not require authentication.
# ---------------------------------------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# ---------------------------------------------------------------------------
# 4. PostGIS Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
# For local Docker stack: postgresql://thermaleye:thermaleye_secret@localhost:5432/thermaleye
# Inside docker container network: postgresql://thermaleye:thermaleye_secret@db:5432/thermaleye
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://thermaleye:thermaleye_secret@localhost:5432/thermaleye

# ---------------------------------------------------------------------------
# 5. Service Host & Port (Optional)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
